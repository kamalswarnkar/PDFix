# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Django
DJANGO_SECRET_KEY=change-me-use-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
DEBUG=false

# Database (optional — leave blank to use SQLite locally)
# On Railway/Render/Fly this is injected automatically.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Email (Gmail SMTP — use an App Password, not your login password)
# Leave blank to disable email; submissions are still saved to the database.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
FEEDBACK_EMAIL=
