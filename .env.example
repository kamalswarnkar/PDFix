# Copy this file to .env and fill in your values. Never commit .env.
# settings.py loads .env automatically; real environment variables win over it.

# ── Django ────────────────────────────────────────────────────────────────
# Required in production - the app refuses to start without it.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-use-a-long-random-string
# Leave this false. The HTTPS-only settings (SSL redirect, secure cookies, HSTS)
# are skipped automatically under `manage.py runserver` and `manage.py test`,
# so a production-shaped .env still works for local development.
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
# Needed for POSTs over HTTPS on a custom domain. Railway/Render hosts are
# added automatically from RAILWAY_PUBLIC_DOMAIN / RENDER_EXTERNAL_URL.
CSRF_TRUSTED_ORIGINS=

# Set to false only if you terminate TLS somewhere that cannot set
# X-Forwarded-Proto. Leave unset in normal deployments.
# SECURE_SSL_REDIRECT=true
# Raise to 31536000 once you are certain HTTPS is permanent.
# SECURE_HSTS_SECONDS=86400

# ── Database ──────────────────────────────────────────────────────────────
# Leave blank for SQLite locally. Railway/Render/Fly inject this automatically.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ── Upload and processing limits ──────────────────────────────────────────
MAX_UPLOAD_MB=50
MAX_UPLOAD_TOTAL_MB=100
MAX_UPLOAD_FILES=25
# Per-engine timeout for Ghostscript / LibreOffice. Keep well below the
# gunicorn --timeout in the Procfile (300s).
CONVERT_TIMEOUT_SECONDS=90
# How long an output file may linger if a worker died mid-download.
MEDIA_RETENTION_SECONDS=1800

# ── Email (Gmail) ───────────────────────────────────────────────
# Feedback and suggestions are always saved to the database; email is a bonus.
# Configure nothing and messages print to the console.
#
# Option 1 - Gmail API over HTTPS (preferred; works where SMTP is blocked,
#            such as Render's free and starter tiers). Get these three with:
#
#              python manage.py gmail_auth --client-id XXX --client-secret YYY
#
#            (that command prints the setup steps if you have no client yet)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Option 2 - Gmail SMTP. Simpler, but needs an unblocked outbound port 587.
#            EMAIL_HOST_PASSWORD must be a Google App Password
#            (https://myaccount.google.com/apppasswords), NOT your account
#            password. Spaces in it are stripped automatically.
#            Used only when the three GMAIL_* values above are empty.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Gmail forces the From to the authenticated account; leave blank to use it.
DEFAULT_FROM_EMAIL=
# Where bug reports and suggestions are delivered.
FEEDBACK_EMAIL=kamalswarnkar0111@gmail.com
EMAIL_TIMEOUT=15

# Reports allowed per IP per window, to keep the form from burning the quota.
FEEDBACK_RATE_LIMIT=5
FEEDBACK_RATE_WINDOW_SECONDS=3600

# ── Runtime ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
WEB_CONCURRENCY=2
