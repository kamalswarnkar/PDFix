# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Django
DJANGO_SECRET_KEY=change-me-use-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
DEBUG=false

# Database (optional — leave blank to use SQLite locally)
# On Railway/Render/Fly this is injected automatically.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Email — Brevo SMTP (for local dev only; Render blocks port 587)
# Leave blank to disable email locally; submissions are still saved to the database.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
FEEDBACK_EMAIL=kamalswarnkar0111@gmail.com

# Brevo API key — used in production (bypasses SMTP port block on Render/Railway).
# Brevo Dashboard → Settings (gear icon) → API Keys → Create API Key
# This is DIFFERENT from the SMTP key above.
BREVO_API_KEY=
