# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Django
DJANGO_SECRET_KEY=change-me-use-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
DEBUG=false

# Database (optional — leave blank to use SQLite locally)
# On Railway/Render/Fly this is injected automatically.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Email — Brevo SMTP (recommended: fast, free up to 300 emails/day)
# 1. Sign up at https://app.brevo.com
# 2. Go to Transactional → Settings → SMTP & API → Generate SMTP Key
# 3. EMAIL_HOST_USER  = your Brevo login email (e.g. you@gmail.com)
# 4. EMAIL_HOST_PASSWORD = the SMTP key Brevo generates (NOT your account password)
# 5. DEFAULT_FROM_EMAIL = a verified sender address in your Brevo account
# Leave blank to disable email; submissions are still saved to the database.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
FEEDBACK_EMAIL=kamalswarnkar0111@gmail.com
